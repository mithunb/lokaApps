node_modules/
.env
*.log
.DS_Store

# LOKA Atlas: server-generated datasets & working state (only the reference dataset is tracked)
atlas/datasets/*
!atlas/datasets/deoria-bioregion
atlas/datasets/deoria-bioregion/manifest.local.json
atlas/datasets/deoria-bioregion/user-*.geojson
# the search index and its embedding binaries are derived from the layers and
# rebuilt on demand — the one tracked dataset must not start carrying them
atlas/datasets/deoria-bioregion/search.local.json
atlas/datasets/deoria-bioregion/search-*.vec
api/data/
api/atlas-builders/.venv/
__pycache__/
.claude/

# Design study pages. These are scratch: they carry working measurements, open
# bugs and internal argument, and a `git add -A atlas/` swept sixteen of them
# into the repo and onto the public site by accident. They stay on disk to be
# read locally and out of the repo entirely.
atlas/*-mock.html
atlas/*-check.html
