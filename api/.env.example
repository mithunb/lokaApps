LOKA_PORT=8181
GEMINI_API_KEY=replace-me

# --- LOKA Atlas wizard ---
# Admin auth for approvals + ops (any long random string)
ATLAS_ADMIN_TOKEN=replace-me
# Where approval requests are sent
ATLAS_ADMIN_EMAIL=mithun@socratus.org
# Public site base for links in emails (default: derived from request headers)
# ATLAS_PUBLIC_BASE=https://loka.place
# Free-tier thresholds and limits (defaults shown)
# ATLAS_FREE_MB=5
# ATLAS_MAX_AREA_DEG2=6
# ATLAS_MAX_INSTANCES=50
# ATLAS_PER_IP_PER_DAY=3
# Python for the dataset builder (default: api/atlas-builders/.venv/bin/python3)
# ATLAS_PYTHON=/usr/bin/python3

# --- outbound mail (magic links + approvals); unset = links logged to pm2 logs ---
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=postmaster@example.org
# SMTP_PASS=replace-me
# MAIL_FROM="LOKA Atlas <atlas@loka.place>"

# --- local development only: serve the repo at /apps with the API rewrite ---
# LOKA_DEV_STATIC=1
