{
  "comment": "Named places that are not administrative units, and where to get their shape. THE SHAPES ARE NOT HERE — only names, aliases and an id, which is a few bytes each. A build fetches the geometry for the entries an atlas actually mentions, by id, and caches it. Fetching by NAME is what puts Jeevan Bhima Nagar in Chennai and BRT in Periyar; fetching by id is deterministic. Every id below was looked up and confirmed before being written down. bbox is [w,s,e,n] and exists so a build can decide what it needs WITHOUT fetching anything.",
  "sources": {
    "osm": {
      "label": "OpenStreetMap",
      "fetch": "https://nominatim.openstreetmap.org/lookup?osm_ids={id}&format=json&polygon_geojson=1",
      "credit": "© OpenStreetMap contributors",
      "licence": "ODbL 1.0",
      "note": "one request a second, per their policy; the result is cached"
    },
    "file": {
      "label": "shipped with the atlas",
      "fetch": "api/atlas-builders/places/{id}",
      "credit": "see each entry",
      "licence": "see each entry"
    },
    "ramsar": {
      "label": "Ramsar Sites Information Service",
      "fetch": "https://rsis.ramsar.org/geoserver/wfs?service=WFS&version=1.1.0&request=GetFeature&typeName=ramsar_sdi:features_bnd&outputFormat=application/json&CQL_FILTER=ramsarid={id}",
      "credit": "Ramsar Sites Information Service",
      "licence": "open access (rsis.ramsar.org/about)"
    }
  },
