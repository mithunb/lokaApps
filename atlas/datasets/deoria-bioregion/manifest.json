{
  "id": "deoria-bioregion",
  "title": "Deoria · Kushinagar · Gorakhpur",
  "subtitle": "A bioregional map for the Basket of Needs survey",
  "about": "Crop systems, value-chain infrastructure and the ecological landscape across three eastern-UP districts — a shared map to help select the survey villages and frame the bioregion. A collaboration between LOKA and the Systems Practice at Socratus, with Jagriti as the on-ground partner.",
  "center": [83.72, 26.68],
  "zoom": 8.2,
  "bounds": [[83.0, 26.03], [84.47, 27.34]],
  "minzoom": 6.5,
  "maxzoom": 15,
  "glyphs": "https://tiles.basemaps.cartocdn.com/fonts/{fontstack}/{range}.pbf",
  "basemaps": [
    {
      "id": "satellite", "label": "Satellite",
      "tiles": ["https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"],
      "tileSize": 256, "maxzoom": 19,
      "attribution": "Imagery © Esri, Maxar, Earthstar Geographics"
    },
    {
      "id": "light", "label": "Map", "default": true,
      "tiles": ["https://a.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}.png", "https://b.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}.png", "https://c.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}.png"],
      "tileSize": 256, "maxzoom": 19,
      "attribution": "© OpenStreetMap contributors © CARTO"
    }
  ],
  "groups": [
    { "id": "base", "label": "Base", "open": true },
    { "id": "agri", "label": "Crops & value chain", "open": true },
    { "id": "eco", "label": "Ecological landscape", "open": true }
  ],
  "layers": [
    {
      "id": "lulc", "group": "eco", "type": "image", "source": "lulc.json",
      "label": "Land use / land cover", "default": false, "opacityControl": true, "opacity": 0.75,
      "info": "ESA WorldCover 2021 (10 m), clipped to the three districts.",
      "legendFrom": "source"
    },
    {
      "id": "crops", "group": "agri", "type": "categories", "source": "blocks.geojson",
      "label": "Crop distribution by block", "default": true,
      "arrayProperty": "crops", "countProperty": "ncrops", "nameProperty": "name",
      "defaultMode": "diversity",
      "diversity": { "label": "Crop diversity", "ramp": ["#e7e3d8", "#cdd3b4", "#a9bd8e", "#7f9c65", "#566f42", "#39502f"], "max": 5 },
      "categories": [
        { "name": "Sugarcane", "color": "#4f6b3f" },
        { "name": "Rice", "color": "#6f8fa0" },
        { "name": "Wheat", "color": "#b58a3e" },
        { "name": "Mustard", "color": "#cdb14a" },
        { "name": "Maize", "color": "#b5613a" },
        { "name": "Banana", "color": "#9aad5b" },
        { "name": "Turmeric", "color": "#cc8a33" },
        { "name": "Vegetable Pea", "color": "#7fa06a" }
      ],
      "popup": { "title": "name", "subtitleProperty": "district", "fields": [
        { "type": "tags", "label": "Crops grown", "property": "crops" },
        { "type": "notes", "property": "cropNotes" } ] }
    },
    {
      "id": "floodplain", "group": "eco", "type": "fill", "source": "floodplain.geojson",
      "label": "Floodplain (observed inundation)", "default": false, "opacityControl": true,
      "paint": { "fillColor": "#6d8ba0", "fillOpacity": 0.35, "outlineColor": "#4f6b7e", "outlineWidth": 0.6 },
      "info": "Areas inundated at least once, 1998–2022 (NRSC/ISRO NDEM satellite record).",
      "legend": [{ "color": "#6d8ba0", "label": "Historically flooded" }]
    },
    {
      "id": "wetlands", "group": "eco", "type": "fill", "source": "wetlands.geojson",
      "label": "Wetlands & water bodies", "default": false,
      "paint": { "fillColor": "#5f8f86", "fillOpacity": 0.7, "outlineColor": "#48706a", "outlineWidth": 0.5 },
      "legend": [{ "color": "#5f8f86", "label": "Lakes, ponds, ox-bows, riverine wetlands" }],
      "popup": { "title": "name", "titleFallback": "type", "fields": [
        { "label": "Type", "property": "type" },
        { "label": "Area", "property": "area_ha", "suffix": " ha" } ] }
    },
    {
      "id": "basin", "group": "eco", "type": "fill", "source": "basin.geojson",
      "label": "River sub-basins", "default": false,
      "paint": { "fillColor": "#8aa2b0", "fillOpacity": 0.08, "outlineColor": "#5f7f92", "outlineWidth": 1.4, "outlineDash": [3, 2] },
      "legend": [{ "color": "#5f7f92", "label": "Ghaghara / Gandak sub-basin", "shape": "dashed" }],
      "popup": { "title": "name", "fields": [ { "label": "Basin", "property": "basin" } ] }
    },
    {
      "id": "agro", "group": "eco", "type": "fill", "source": "agro_zones.geojson",
      "label": "Agro-ecological zones", "default": false,
      "paint": { "fillColor": "#9aad5b", "fillOpacity": 0.1, "outlineColor": "#6b7a3f", "outlineWidth": 1.2, "outlineDash": [2, 2] },
      "legend": [{ "color": "#6b7a3f", "label": "Agro-ecological region", "shape": "dashed" }],
      "popup": { "title": "name" }
    },
    {
      "id": "wasteland", "group": "eco", "type": "fill", "source": "wasteland.geojson",
      "label": "Wasteland (open / barren land)", "default": false, "opacityControl": true, "opacity": 0.7,
      "info": "Share of uncultivated open, scrub & barren land per block (ESA WorldCover 2021) — a proxy for revenue wasteland, which isn't openly available as GIS for these districts.",
      "paint": {
        "fillColor": ["step", ["get", "wl_pct"], "#efe6d9", 1.5, "#ddc4a0", 3, "#caa06f", 5, "#a8703f", 7, "#824e26"],
        "fillOpacity": 0.7, "outlineColor": "#7a5a3a", "outlineWidth": 0.4
      },
      "legend": [
        { "color": "#efe6d9", "label": "< 1.5%" },
        { "color": "#ddc4a0", "label": "1.5–3%" },
        { "color": "#caa06f", "label": "3–5%" },
        { "color": "#a8703f", "label": "5–7%" },
        { "color": "#824e26", "label": "> 7%" }
      ],
      "popup": { "title": "name", "subtitleProperty": "district", "fields": [
        { "label": "Open / barren land", "property": "wl_pct", "suffix": "% of block area" } ] }
    },
    {
      "id": "forests", "group": "eco", "type": "fill", "source": "forests.geojson",
      "label": "Reserved & protected forests", "default": false,
      "info": "Forest boundary polygons from Survey of India topo maps (reserved / protected).",
      "paint": {
        "fillColor": ["match", ["get", "type"], "Reserved", "#2f4a30", "#6f7d43"],
        "fillOpacity": 0.6,
        "outlineColor": ["match", ["get", "type"], "Reserved", "#22371f", "#556232"],
        "outlineWidth": 0.8
      },
      "legend": [
        { "color": "#2f4a30", "label": "Reserved forest" },
        { "color": "#6f7d43", "label": "Protected forest" }
      ],
      "popup": { "title": "name", "titleFallback": "type", "subtitleProperty": "type", "fields": [] }
    },
    {
      "id": "canals", "group": "eco", "type": "line", "source": "canals.geojson",
      "label": "Canals", "default": false,
      "paint": { "color": "#7ba0b0", "width": 1.4, "opacity": 0.9 },
      "legend": [{ "color": "#7ba0b0", "label": "Irrigation canal", "shape": "line" }],
      "popup": { "title": "name", "fields": [ { "label": "Project", "property": "project" } ] }
    },
    {
      "id": "rivers", "group": "eco", "type": "line", "source": "rivers.geojson",
      "label": "Rivers & drainage", "default": false,
      "paint": {
        "color": "#5f7f92",
        "width": ["case", ["==", ["get", "layer"], "major"], 2.6, 1.1],
        "opacity": 0.95
      },
      "label_text": { "property": "name", "size": 11, "color": "#35505f", "haloColor": "#eaf2ff", "haloWidth": 1.4, "minzoom": 9 },
      "legend": [{ "color": "#5f7f92", "label": "River / stream", "shape": "line" }],
      "popup": { "title": "name", "fields": [
        { "label": "Class", "property": "layer" }, { "label": "Sub-basin", "property": "sub_basin" } ] }
    },
    {
      "id": "districts", "group": "base", "type": "fill", "source": "districts.geojson",
      "label": "District boundaries", "default": true,
      "paint": { "fillColor": "#000000", "fillOpacity": 0, "outlineColor": "#B0863A", "outlineWidth": 2.6 },
      "label_text": { "property": "name", "size": 15, "color": "#1e2a1c", "haloColor": "#ffffff", "haloWidth": 2.2, "transform": "uppercase", "letterSpacing": 0.12, "minzoom": 7 },
      "legend": [{ "color": "#B0863A", "label": "District", "shape": "line" }],
      "popup": { "title": "name", "subtitle": "District", "fields": [
        { "label": "Dominant crops", "property": "crops" },
        { "label": "Soil", "property": "soil" },
        { "label": "Water resources", "property": "water" },
        { "label": "ODOP", "property": "odop" },
        { "label": "Value-chain infra", "property": "valuechain" } ] }
    },
    {
      "id": "blocks", "group": "base", "type": "fill", "source": "blocks.geojson",
      "label": "Block boundaries & labels", "default": true,
      "paint": { "fillColor": "#000000", "fillOpacity": 0, "outlineColor": "#5c544a", "outlineWidth": 1, "outlineOpacity": 0.42 },
      "label_text": { "property": "name", "size": 11, "color": "#2b2723", "haloColor": "#ffffff", "haloWidth": 1.6, "minzoom": 9 }
    },
    {
      "id": "clusters", "group": "base", "type": "fill", "source": "clusters.geojson",
      "label": "Survey clusters", "default": true,
      "paint": { "fillColor": "#A6522F", "fillOpacity": 0.12, "outlineColor": "#A6522F", "outlineWidth": 2.4, "outlineDash": [2, 1.5] },
      "label_text": { "property": "name", "size": 13, "color": "#7E3B1F", "haloColor": "#ffedd5", "haloWidth": 1.6 },
      "legend": [{ "color": "#A6522F", "label": "Confirmed cluster (5 villages)", "shape": "dashed" }],
      "popup": { "title": "name", "fields": [
        { "label": "District", "property": "district" },
        { "label": "Block", "property": "block" },
        { "type": "tags", "label": "Villages", "property": "villages" } ] }
    },
    {
      "id": "valuechain", "group": "agri", "type": "marker", "source": "valuechain.geojson",
      "label": "Value-chain nodes", "default": true,
      "markerBy": "type",
      "markers": {
        "Sugar mill": { "color": "#9C5A34", "icon": "factory" },
        "Distillery": { "color": "#40573D", "icon": "flask" }
      },
      "label_text": { "property": "name" },
      "legend": [
        { "color": "#9C5A34", "label": "Sugar mill", "icon": "factory" },
        { "color": "#40573D", "label": "Distillery", "icon": "flask" }
      ],
      "popup": { "title": "name", "subtitleProperty": "type", "fields": [
        { "label": "District", "property": "district" },
        { "label": "About", "property": "note" },
        { "label": "Location", "property": "location_source" } ] }
    },
    {
      "id": "villages", "group": "base", "type": "marker", "source": "villages.geojson",
      "label": "Survey villages", "default": true,
      "marker": { "color": "#A6522F", "ring": true },
      "cluster": { "belowZoom": 10.8, "label": "Cluster 1" },
      "label_text": { "property": "name" },
      "legend": [{ "color": "#A6522F", "label": "Survey village", "shape": "dot" }],
      "popup": { "title": "name", "subtitle": "Cluster 1 survey village", "fields": [
        { "label": "Block", "property": "block" },
        { "label": "LGD village", "property": "matched" } ] }
    },
    {
      "id": "labels", "group": "base", "type": "raster", "default": true,
      "label": "Place labels (satellite)", "onlyWithBasemap": "satellite",
      "tiles": ["https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}"],
      "tileSize": 256, "attribution": "Labels © Esri"
    }
  ],
  "attributions": [
    { "name": "Bharatlas", "url": "https://bharatlas.com", "note": "Boundaries, rivers, sub-basins, flood inundation, wetlands, ethanol plants (aggregated)", "license": "CC0 / CC-BY 4.0" },
    { "name": "Local Government Directory (LGD)", "url": "https://lgdirectory.gov.in", "note": "District, block & village boundaries" },
    { "name": "India-WRIS, Central Water Commission", "url": "https://indiawris.gov.in", "note": "Rivers, sub-basins, canals" },
    { "name": "NRSC / ISRO — NDEM", "url": "https://bhuvan.nrsc.gov.in", "note": "Flood inundation 1998–2022" },
    { "name": "ESA WorldCover 2021 (Copernicus)", "url": "https://esa-worldcover.org", "note": "Land use / land cover", "license": "CC-BY 4.0" },
    { "name": "Esri World Imagery", "url": "https://www.esri.com", "note": "Satellite basemap & place labels" },
    { "name": "OpenStreetMap contributors & CARTO", "url": "https://www.openstreetmap.org/copyright", "note": "Map basemap, geocoding", "license": "ODbL" },
    { "name": "Systems Practice, Socratus", "url": "https://socratus.org", "note": "Value-chain desk research — crop-by-block & value-chain data" }
  ]
}
